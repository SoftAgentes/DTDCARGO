// ════════════════════════════════════════════════════════════════════
//  DTD-Cargo · schema.prisma  ·  v0.1 (arranque de backend · CRÍTICO #1)
//  Derivado 1:1 de los shapes mock del front (window.ERPData / *Data).
//  Reglas que NO se negocian (ver backend/README.md · CLAUDE.md):
//    · TODA tabla operativa lleva tenantId y TODA query lo filtra.
//    · MARKBOX y numeraciones (F- DTDU- CXP- REF- REC- DOC-) son
//      secuenciales SERVER-SIDE (no confiar en el cliente).
//    · Moneda funcional USD · VES @ BCV solo para lo fiscal.
//    · IVA/SENIAT = flag de tenant, OFF por defecto.
//  El backend nunca toma tenantId del body: lo resuelve del JWT.
// ════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────

enum TenantStatus   { active suspended trial archived }
enum TenantPlan     { starter growth enterprise white_label }

enum UserRole {
  // Plataforma (tenantId = null)
  super_admin
  bug_manager
  change_operator
  // Tenant
  tenant_admin
  comercial
  operaciones
  contabilidad
  almacen_cn
  almacen_ve
  soporte
}
enum UserStatus     { active invited suspended }

enum ClientSegment  { Industrial Retail Tecnologia Mayorista Comercial Servicios Textil Belleza Otro }
enum RecordStatus   { active pending inactive }

enum ShipmentType   { FCL_20 FCL_40 FCL_40HC LCL_DDP }
enum ShipmentStatus {
  cotizado confirmado recibido_cn consolidado zarpado
  transito aduana_ve liberado entregado cancelado
}

enum BoxStatus      { esperado recibido_cn consolidado en_transito entregado }
enum BoxFlag        { peligrosa fragil marca licencia sobrepeso }

enum InvoiceStatus  { borrador emitida parcial pagada vencida anulada }
enum Currency       { USD VES USDT CNY }

enum QuoteStatus    { borrador enviada aceptada rechazada vencida }

enum OrderStatus    { creada en_compra en_bodega_cn embarcada cerrada }

enum DocumentKind   { BL packing_list factura certificado licencia foto otro }
enum DocumentStatus { pendiente cargado validado rechazado }

enum ContainerStatus{ abierto consolidando sellado zarpado arribado }

enum EmailChannel   { email whatsapp }
enum EmailStatus    { programado enviado fallido cancelado }

enum IncidentType   { mecanica accidente multa demora documentacion otro }
enum Severity       { baja media alta critica }
enum IncidentStatus { abierta en_proceso resuelta }

enum AcctType       { A P PT I CGS G } // Activo Pasivo Patrimonio Ingreso CostoVenta Gasto
enum EntryStatus    { borrador asentado anulado }

// ─────────────────────────────────────────────────────────────────────
// PLATAFORMA
// ─────────────────────────────────────────────────────────────────────

model Tenant {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  plan           TenantPlan   @default(growth)
  status         TenantStatus @default(active)
  codePrefix     String       @default("DTD")   // prefijo MARKBOX
  brandConfig    Json?                            // colores/logo white-label
  modulesEnabled String[]     @default([])        // reemplaza FEATURE_FLAG_DEFAULTS
  ivaEnabled     Boolean      @default(false)     // toggle SENIAT, OFF por defecto
  markboxSeq     Int          @default(5499)      // contador MARKBOX (baseline)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users          User[]
  clients        Client[]
  suppliers      Supplier[]
  orders         Order[]
  shipments      Shipment[]
  boxes          Box[]
  invoices       Invoice[]
  quotes         Quote[]
  warehouseEvts  WarehouseEvent[]
  documents      Document[]
  containers     Container[]
  comments       Comment[]
  scheduledMails ScheduledEmail[]
  incidents      TmsIncident[]
  accounts       Account[]
  journalEntries JournalEntry[]
  rates          ExchangeRate[]
  auditLogs      AuditLog[]

  @@index([slug])
}

model User {
  id          String     @id @default(cuid())
  tenantId    String?    // NULL = usuario de Plataforma
  tenant      Tenant?    @relation(fields: [tenantId], references: [id])
  name        String
  email       String     @unique
  passwordHash String
  role        UserRole
  team        String?
  status      UserStatus @default(active)
  twoFa       Boolean    @default(false)
  twoFaSecret String?
  phone       String?
  avatar      String?
  scope       String?    // hub: CN / VE / global
  preferences Json?      // reemplaza localStorage('dtd_prefs')
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  comments    Comment[]
  auditLogs   AuditLog[]
  quotes      Quote[]    @relation("QuoteAgent")

  @@index([tenantId])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────────────
// COMERCIAL
// ─────────────────────────────────────────────────────────────────────

model Client {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  markbox   String        // {codePrefix}-{NNNN}  → DTD-5452
  name      String
  company   String?
  rif       String?       // J-30182554-9
  segment   ClientSegment @default(Otro)
  city      String?
  status    RecordStatus  @default(active)
  email     String?
  phone     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  suppliers Supplier[]
  orders    Order[]
  shipments Shipment[]
  invoices  Invoice[]
  quotes    Quote[]

  @@unique([tenantId, markbox])
  @@index([tenantId])
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  clientId  String?  // proveedor CN asociado a un cliente
  client    Client?  @relation(fields: [clientId], references: [id])
  name      String
  cnName    String?  // 中文名 — Noto Sans SC
  city      String?
  province  String?
  industry  String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]

  @@index([tenantId])
  @@index([clientId])
}

model Order {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id])
  supplierId String?
  supplier   Supplier?   @relation(fields: [supplierId], references: [id])
  seq        Int         // contador por proveedor (compra#)
  code       String      // {markbox}-{proveedor#}-{compra#} → DTD-5509-1-2
  status     OrderStatus @default(creada)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  shipments  Shipment[]
  boxes      Box[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────────────
// LOGÍSTICA
// ─────────────────────────────────────────────────────────────────────

model Shipment {
  id          String         @id // DTDU-472816 (secuencial server-side)
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id])
  orderId     String?
  order       Order?         @relation(fields: [orderId], references: [id])
  type        ShipmentType
  origin      String         // puerto/hub: YIW SZX CAN SHA
  destination String         // PBL MAR LGU PFI
  cbm         Float
  weight      Float          // kg
  value       Float          // USD
  status      ShipmentStatus @default(cotizado)
  etd         DateTime?
  eta         DateTime?
  containerId String?
  container   Container?     @relation(fields: [containerId], references: [id])
  billed      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  boxes         Box[]
  invoices      Invoice[]
  warehouseEvts WarehouseEvent[]
  documents     Document[]

  @@index([tenantId])
  @@index([clientId])
  @@index([status])
}

model Box {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  shipmentId String?
  shipment   Shipment?  @relation(fields: [shipmentId], references: [id])
  orderId    String?
  order      Order?     @relation(fields: [orderId], references: [id])
  label      String
  qr         String?    @unique
  status     BoxStatus  @default(esperado)
  flags      BoxFlag[]  @default([])
  cbm        Float?
  weight     Float?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([tenantId])
  @@index([shipmentId])
}

model Container {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  code      String          // contenedor / DTDU consolidado
  seal      String?
  bl        String?         // Bill of Lading
  cbmTotal  Float           @default(0)
  status    ContainerStatus @default(abierto)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  shipments Shipment[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model WarehouseEvent {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  hub        String   // CN / VE
  type       String   // recepcion / inspeccion / consolidacion / despacho
  payload    Json?
  photos     String[] @default([]) // urls S3/R2
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([shipmentId])
}

// ─────────────────────────────────────────────────────────────────────
// FINANZAS
// ─────────────────────────────────────────────────────────────────────

model Invoice {
  id         String        @id // F-2026-XXXX (secuencial server-side)
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  clientId   String
  client     Client        @relation(fields: [clientId], references: [id])
  shipmentId String?
  shipment   Shipment?     @relation(fields: [shipmentId], references: [id])
  amount     Float
  currency   Currency      @default(USD)
  fxRate     Float?        // BCV usado para asiento/declaración VES
  status     InvoiceStatus @default(borrador)
  issued     DateTime?
  due        DateTime?
  paidAmount Float         @default(0)
  lines      Json          // [{ itemId, desc, qty, unitPrice, account }]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  journalEntries JournalEntry[]

  @@index([tenantId])
  @@index([clientId])
  @@index([status])
}

model Quote {
  id          String      @id // REF-/cotización
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  clientId    String?
  client      Client?     @relation(fields: [clientId], references: [id])
  agentId     String?
  agent       User?       @relation("QuoteAgent", fields: [agentId], references: [id])
  type        String
  origin      String?
  destination String?
  cbm         Float?
  totalUsd    Float
  status      QuoteStatus @default(borrador)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([tenantId])
  @@index([clientId])
}

// Plan de cuentas (161 cuentas reales · jerárquico padre→hijo)
model Account {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  type      AcctType
  parentId  String?
  parent    Account? @relation("AcctTree", fields: [parentId], references: [id])
  children  Account[] @relation("AcctTree")
  createdAt DateTime @default(now())

  lines     JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model JournalEntry {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  date      DateTime
  memo      String?
  status    EntryStatus  @default(borrador)
  invoiceId String?      // asiento automático desde factura
  invoice   Invoice?     @relation(fields: [invoiceId], references: [id])
  createdAt DateTime     @default(now())

  lines     JournalLine[]

  @@index([tenantId])
}

model JournalLine {
  id        String       @id @default(cuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id])
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
  debit     Float        @default(0)
  credit    Float        @default(0)

  @@index([entryId])
  @@index([accountId])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  source    String   // BCV / paralelo / CNY
  pair      String   // USD/VES, USDT/VES, CNY/USD
  value     Float
  asOf      DateTime
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([source])
}

// ─────────────────────────────────────────────────────────────────────
// COMUNICACIÓN / OPERACIÓN
// ─────────────────────────────────────────────────────────────────────

model Comment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  recordType String   // shipment / client / invoice / ...
  recordId   String
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  mentions   String[] @default([])
  reactions  Json?
  parentId   String?
  parent     Comment? @relation("Thread", fields: [parentId], references: [id])
  replies    Comment[] @relation("Thread")
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([recordType, recordId])
}

model ScheduledEmail {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  to          String
  subject     String
  channel     EmailChannel @default(email)
  scheduledAt DateTime
  status      EmailStatus  @default(programado)
  attachments String[]     @default([])
  templateId  String?      // m-05 etc.
  body        String?
  createdAt   DateTime     @default(now())

  @@index([tenantId])
  @@index([status])
}

model TmsIncident {
  id        String         @id @default(cuid())
  tenantId  String          // nota: flota es infra compartida; ver BRIEF
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  truck     String
  type      IncidentType
  severity  Severity       @default(media)
  date      DateTime
  desc      String
  cost      Float          @default(0)
  status    IncidentStatus @default(abierta)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([tenantId])
}

model Document {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  shipmentId String?
  shipment   Shipment?      @relation(fields: [shipmentId], references: [id])
  clientRef  String?        // markbox o id de cliente
  kind       DocumentKind
  url        String?        // S3/R2
  status     DocumentStatus @default(pendiente)
  version    Int            @default(1)
  createdAt  DateTime       @default(now())

  @@index([tenantId])
  @@index([shipmentId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  target    String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([actorId])
}
