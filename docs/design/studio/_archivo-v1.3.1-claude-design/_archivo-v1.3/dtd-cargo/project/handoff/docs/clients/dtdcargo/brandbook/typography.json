{
  "$schema": "https://dtdcargo.com/schemas/brand-typography.v1.json",
  "brand": "DTD-Cargo",
  "version": "2.0",
  "updated": "2026-05-21",
  "families": {
    "display": {
      "name": "Archivo Black",
      "google_font": "https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap",
      "fallback": "Arial Black, Impact, sans-serif",
      "usage": "Titulares, números grandes (KPIs, MARKBOX), wordmark, badges enfáticos",
      "available_weights": [900]
    },
    "body": {
      "name": "Archivo",
      "google_font": "https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;500;600;700;800;900&display=swap",
      "fallback": "system-ui, -apple-system, 'Segoe UI', sans-serif",
      "usage": "Body, UI, labels, copy general",
      "available_weights": [300, 400, 500, 600, 700, 800, 900]
    },
    "chinese": {
      "name": "Noto Sans SC",
      "google_font": "https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700;900&display=swap",
      "fallback": "'PingFang SC', 'Microsoft YaHei', sans-serif",
      "usage": "Solo para el lockup bilingüe 德拓 y el clip dirigido a proveedores chinos",
      "available_weights": [400, 500, 700, 900]
    },
    "mono": {
      "name": "ui-monospace, SFMono-Regular, Menlo, Monaco, monospace",
      "usage": "Códigos (DTDU, MARKBOX, HEX, snippets), tracking IDs, datos técnicos"
    }
  },
  "scale": {
    "h_display": {
      "family": "Archivo Black",
      "weight": 900,
      "size": "clamp(48px, 7.2vw, 112px)",
      "line_height": 0.92,
      "letter_spacing": "-0.025em",
      "usage": "Hero principal de landing"
    },
    "h_section": {
      "family": "Archivo Black",
      "weight": 900,
      "size": "clamp(36px, 5vw, 64px)",
      "line_height": 0.95,
      "letter_spacing": "-0.02em",
      "usage": "Títulos de página dentro del brand book"
    },
    "h_card": {
      "family": "Archivo",
      "weight": 800,
      "size": "22px",
      "line_height": 1.1,
      "letter_spacing": "-0.01em",
      "usage": "Títulos dentro de cards"
    },
    "eyebrow": {
      "family": "Archivo",
      "weight": 600,
      "size": "11px",
      "letter_spacing": "0.14em",
      "transform": "uppercase",
      "color": "grey_500",
      "decoration": "Prefijo: una barrita vino de 18px de ancho antes del texto",
      "usage": "Categoría/sección sobre cada página"
    },
    "lead": {
      "family": "Archivo",
      "weight": 400,
      "size": "17px",
      "line_height": 1.55,
      "color": "grey_500",
      "max_width": "56ch",
      "usage": "Bajada/lead bajo título de sección"
    },
    "body": {
      "family": "Archivo",
      "weight": 400,
      "size": "14.5px",
      "line_height": 1.5,
      "usage": "Body por defecto"
    },
    "caption": {
      "family": "Archivo",
      "weight": 500,
      "size": "12px",
      "line_height": 1.4,
      "color": "grey_500",
      "usage": "Captions, notas al pie, metadata"
    },
    "code": {
      "family": "mono",
      "weight": 700,
      "size": "12.5px",
      "color": "ink",
      "usage": "Códigos inline (MARKBOX, DTDU, HEX)"
    }
  },
  "rules": [
    "Wordmark DTD-Cargo SIEMPRE en Archivo Black, NUNCA simulado con otra fuente",
    "El isótipo se acompaña del wordmark salvo en favicon/avatar cuadrado",
    "Mínimo display: 24px. Mínimo body: 12px. Mínimo caption: 10px",
    "Letter-spacing negativo SOLO en Archivo Black (size >= 22px)",
    "Letter-spacing positivo (0.06–0.18em) SOLO en eyebrows uppercase",
    "No usar fuentes que la marca no declare: Inter, Roboto, system-ui plana — todas prohibidas para titulares"
  ]
}
