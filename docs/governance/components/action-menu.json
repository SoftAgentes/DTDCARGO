{
  "schemaVersion": "1.1",
  "id": "action-menu",
  "name": "ActionMenu",
  "purpose": "Agrupar acciones dispares o poco frecuentes detrás de un trigger, con el contrato de teclado y foco de BTN-01 §7 implementado una sola vez.",
  "owner": "Studio UI",
  "status": "proposed",
  "implementation": {
    "path": "app/studio/_components/ui/ActionMenu.tsx",
    "exportName": "ActionMenu"
  },
  "policyRefs": [
    {
      "code": "SGE-00",
      "version": "1.0",
      "path": "docs/governance/policies/sge-00.md"
    },
    {
      "code": "BTN-01",
      "version": "1.1",
      "path": "docs/governance/policies/btn-01.md"
    },
    {
      "code": "A11Y-01",
      "version": "1.1",
      "path": "docs/governance/policies/a11y-01.md"
    },
    {
      "code": "CMP-01",
      "version": "1.1",
      "path": "docs/governance/policies/cmp-01.md"
    }
  ],
  "api": {
    "contractPath": "docs/specs/0263-primitiva-de-menu-de-acciones/spec.md",
    "summary": "Trigger con texto o sólo icono (ariaLabel obligatorio), items con rol semántico default/destructive, separadores, deshabilitado con motivo visible, alineación y tamaño. Sin memoria de la última opción, a propósito."
  },
  "tokens": [
    "--bg-surface",
    "--bg-elevated",
    "--border",
    "--ink",
    "--ink-soft",
    "--danger",
    "--r-sm",
    "--r-md",
    "--shadow-pop",
    "--f-sans"
  ],
  "accessibility": {
    "keyboard": "verified",
    "focus": "verified",
    "screenReader": "verified",
    "contrast": "verified",
    "reducedMotion": "not-applicable",
    "evidence": [
      "app/studio/_components/ui/ActionMenu.test.tsx",
      "docs/specs/0263-primitiva-de-menu-de-acciones/spec.md"
    ]
  },
  "breakpoints": ["mobile", "tablet", "desktop"],
  "examples": {
    "correct": ["app/studio/_components/ui/ActionMenu.test.tsx"],
    "incorrect": [
      "app/studio/(app)/ve/_components/VeRowActions.tsx",
      "app/studio/(app)/bitacora/_components/ExportMenu.tsx",
      "app/studio/_components/ui/columns/ColumnConfig.tsx"
    ]
  },
  "tests": [
    {
      "type": "accessibility",
      "path": "app/studio/_components/ui/ActionMenu.test.tsx",
      "case": "Las 11 reglas de teclado y foco de BTN-01 §7: roving focus, flechas con vuelta, Home/End, Enter, Escape con retorno al trigger, apertura por primera/última, Tab, clic afuera y hover sin ejecutar."
    }
  ],
  "consumers": [],
  "review": {
