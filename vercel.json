{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)docs/**' ':(exclude,glob)*.md' && git diff --quiet HEAD^ HEAD -- docs/marketing",
  "crons": [
    {
      "path": "/api/cron/ceo-brief",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/kommo-contact-status",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/push-drain",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/client-notifications-drain",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/purge-throttle",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/purge-receipt-orphans",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/bitacora-purge-orphans",
      "schedule": "30 3 * * 1"
    },
    {
      "path": "/api/cron/mail-scheduled",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/bitacora-digest",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/conversation-digests",
      "schedule": "0 5 1 * *"
    },
    {
      "path": "/api/cron/portal-cold-reminder",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/bug-notifications-drain",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/workflow-drain",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/rate-expiry-alert",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/mail-health",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/alta-health",
      "schedule": "0 12 * * *"
    }
  ]
}
