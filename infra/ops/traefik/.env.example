# infra/ops/traefik/.env.example — copia a .env junto al compose.yml (SDD-0505).
# Solo nombres y placeholders; el .env no se sube a Git.

# Correo que Let's Encrypt usa para avisos de vencimiento.
ACME_EMAIL=ops@ejemplo.com

# CIDRs de los proxies de confianza cuyos X-Forwarded-* se conservan. Sin
# Cloudflare delante, déjalo en loopback. Con Cloudflare proxied: sus rangos
# (https://www.cloudflare.com/ips/), separados por coma.
TRUSTED_PROXY_CIDRS=127.0.0.1/32
