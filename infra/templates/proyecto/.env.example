############################################################################
# infra/templates/proyecto/.env.example — variables de un proyecto (SDD-0505)
#
# Copia este archivo a `.env` junto al compose.yml del proyecto y rellena cada
# valor. Solo nombres y placeholders: NUNCA pongas aquí un valor real ni subas
# el `.env` a Git. Genera los secretos con los comandos indicados.
#
# Equivalencias con el panel de Supabase Cloud (Auth, SMTP):
# docs/runbooks/setup-portal-auth.md › «Self-hosted».
############################################################################

############
# Proyecto y Traefik
############

# Nombre del proyecto compose (minúsculas, sin espacios). Da nombre a contenedores,
# redes y a los routers de Traefik. Ej.: loop3d, rentaaguada
PROYECTO=cambia-esto
# Red externa compartida solo con Traefik: `docker network create <valor>`.
# Convención: <PROYECTO>_edge
EDGE_NETWORK=cambia-esto_edge
# Imagen de la app publicada en GHCR (o construida local con Dockerfile.next).
# Siempre con tag exacto (sha-<sha> o main), nunca latest.
WEB_IMAGE=ghcr.io/hailuwaycom-sketch/cambia-esto:sha-0000000000000000000000000000000000000000
# Dominios que Traefik va a servir (DNS apuntando al VPS, o proxied por Cloudflare).
APP_DOMAIN=app.ejemplo.com
SUPABASE_DOMAIN=api.ejemplo.com

############
# App (Next.js)
############

# production · staging · preview · local (ver lib/runtime/app-env.ts en DTD Cargo)
APP_ENV=production
APP_URL=https://app.ejemplo.com
# Header que fija el proxy de confianza con la IP real del cliente.
# Traefik directo: x-real-ip · detrás de Cloudflare: cf-connecting-ip
REQUEST_IP_HEADER=x-real-ip
# Bearer que exige /api/cron/*. Genera: openssl rand -hex 32
CRON_SECRET=
# Memoria máxima del contenedor web (deploy.resources.limits).
WEB_MEMORY_LIMIT=1g

############
# Postgres
############

# Genera: openssl rand -base64 32 (solo letras y números; evita caracteres que
# rompan URLs de conexión)
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Ajuste de memoria (ver comentario en compose.yml › db › command)
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=8MB
PG_MAX_CONNECTIONS=100
DB_MEMORY_LIMIT=2g

############
# Llaves de Supabase
############

# Secreto HS256 con el que se firman los JWT. Genera: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY=3600
# API keys legadas (JWT firmados con JWT_SECRET, roles anon y service_role).
# Genera ambas con utils/generate-keys.sh del upstream o con
# https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
ANON_KEY=
SERVICE_ROLE_KEY=
# Llaves opacas nuevas (sb_publishable_* / sb_secret_*) y par ES256: opcionales,
# se generan con utils/add-new-auth-keys.sh del upstream. Vacías = modo legado.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
# Basic auth del dashboard que sirve Envoy en `/` de SUPABASE_DOMAIN.
DASHBOARD_USERNAME=cambia-esto
# Genera: openssl rand -base64 24
DASHBOARD_PASSWORD=
# Mínimo 64 caracteres. Genera: openssl rand -base64 48
SECRET_KEY_BASE=
# Exactamente 16 caracteres. Genera: openssl rand -hex 8
REALTIME_DB_ENC_KEY=
# Mínimo 32 caracteres. Genera: openssl rand -base64 24
PG_META_CRYPTO_KEY=

############
# URLs públicas
############

# Lo que ven los clientes (supabase-js) y Storage: https://<SUPABASE_DOMAIN>
SUPABASE_PUBLIC_URL=https://api.ejemplo.com
# URL externa de Auth: <SUPABASE_PUBLIC_URL>/auth/v1
API_EXTERNAL_URL=https://api.ejemplo.com/auth/v1

############
# Auth (GoTrue)
############

# «Site URL» y «Redirect URLs» del panel de Cloud.
SITE_URL=https://app.ejemplo.com
ADDITIONAL_REDIRECT_URLS=
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

############
# SMTP (correos de Auth)
############

SMTP_ADMIN_EMAIL=no-reply@ejemplo.com
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Ejemplo

############
# Storage
############

# file (disco local, entra en el backup) · s3 (R2/B2: rellena GLOBAL_S3_* y STORAGE_AWS_*)
STORAGE_BACKEND=file
# Con `file` es el nombre de la carpeta bajo /var/lib/storage; con `s3`, el bucket.
GLOBAL_S3_BUCKET=stub
GLOBAL_S3_ENDPOINT=
GLOBAL_S3_PROTOCOL=https
GLOBAL_S3_FORCE_PATH_STYLE=true
STORAGE_AWS_ACCESS_KEY_ID=
STORAGE_AWS_SECRET_ACCESS_KEY=
REGION=stub
STORAGE_TENANT_ID=stub
# Endpoint S3 que expone Storage (S3 protocol). Genera: openssl rand -hex 16 / -hex 32
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
IMGPROXY_AUTO_WEBP=true

############
# PostgREST
############

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# Perfiles opcionales (studio · functions)
############

STUDIO_DEFAULT_ORGANIZATION=Ejemplo
STUDIO_DEFAULT_PROJECT=Ejemplo
OPENAI_API_KEY=
# Studio solo escucha aquí (loopback por defecto). Para entrar por Tailscale pon la
# IP 100.x.y.z del VPS.
STUDIO_BIND_IP=127.0.0.1
STUDIO_PORT=3100
FUNCTIONS_VERIFY_JWT=false

############
# Backup (backup.sh → infra/ops/backup/pg-dump-to-s3.sh + config-backup.sh)
############

# Dónde está la carpeta ops en el servidor.
OPS_DIR=/srv/ops
# Carpeta local de dumps (fuera de los volúmenes de Docker).
BACKUP_DIR=/srv/backups
# Remoto de rclone y prefijo: <remoto>:<bucket>/<prefijo>. Nunca la raíz del bucket.
BACKUP_RCLONE_REMOTE=r2:backups-ejemplo/dumps
# Carpeta con rclone.conf (solo lectura para el contenedor).
RCLONE_CONFIG_DIR=/srv/ops/backup/rclone
# Días que se conservan los dumps en el remoto y en el disco local.
BACKUP_RETENTION_DAYS=30
BACKUP_LOCAL_RETENTION_DAYS=7
# Claves PÚBLICAS de age (una por línea: `age1…` o `ssh-ed25519 …`). Obligatorio:
# sin este archivo el dump no corre. La clave PRIVADA nunca va al servidor.
BACKUP_AGE_RECIPIENTS_FILE=/srv/ops/backup/age-recipients.txt
# Volumen con la clave raíz de pgsodium/Vault, que config-backup.sh respalda junto
# con este .env. Vacío = <PROYECTO>_db-config.
BACKUP_DB_CONFIG_VOLUME=
