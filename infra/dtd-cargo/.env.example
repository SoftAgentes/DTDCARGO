# ─────────────────────────────────────────────────────────────────────────────
# DTD Cargo · servidor propio (SDD-0505) · plantilla del .env del compose
#
#   cp .env.example .env && chmod 600 .env      (en el servidor: /srv/dtd-cargo/.env)
#
# SOLO NOMBRES Y PLACEHOLDERS. Ningún valor real vive en el repo: cada
# `<generar: ...>` se reemplaza en el servidor y el .env nunca entra a git
# (.gitignore de esta carpeta). Las claves demo del compose oficial de Supabase
# (ANON_KEY/SERVICE_ROLE_KEY firmadas con su JWT_SECRET público) NO se copian:
# funcionan tal cual y cualquiera las conoce.
#
# Un solo archivo alimenta a Compose (interpolación de `${...}`) y al contenedor
# `web` (env_file). Dónde se usa cada bloque: compose.yml (app), compose.supabase.yml
# (Supabase), compose.supabase.s3.yml (Storage en R2/B2). Cómo generar las claves
# JWT y el resto: README.md de esta carpeta.
#
# VACÍA NO ES LO MISMO QUE SIN DEFINIR. Una línea `X=` le da a X el valor ""
# dentro del contenedor, y la app todavía lee algunas con `process.env.X ?? respaldo`
# (IDENTITY_CNE_PROVIDER, DTD_ATTACHMENTS_AWS_AUTH_MODE…): con "" el respaldo no
# entra. Los cuatro secretos de firma (EMAIL_UNSUBSCRIBE_SECRET, MARCA_ACCESS_SECRET,
# NEWSLETTER_IP_HASH_SECRET, RESEND_INBOUND_WEBHOOK_SECRET) ya tratan "" como
# ausente (SDD-0523), y los modelos de Anthropic también (SDD-0525). En Vercel esas
# variables no existen. Las líneas vacías de esta plantilla sirven para que
# new-env.sh y env-set.sh sepan qué falta llenar; antes de levantar `web`, las
# que siguen vacías y que ningún compose interpola se BORRAN del .env (runbook
# servidor-contabo §3.6, registro del 2026-10-15).
# ─────────────────────────────────────────────────────────────────────────────

############
# Servidor y Traefik (compose.yml · compose.supabase.yml)
############

# Imagen de la app publicada por CI. Desplegar = cambiar este tag y
# `docker compose pull web && docker compose up -d web cron`. Preferir `sha-<sha>`
# a `main` en producción: dice exactamente qué commit corre.
DTD_WEB_IMAGE=ghcr.io/softagentes/dtdcargo:main
# Imagen de Storage. Sin esta línea va la oficial que fija compose.supabase.yml, y
# eso es lo correcto en un servidor nuevo. Existe porque producción corre una copia
# de esa imagen armada en el servidor, sin copia en ningún registro, con Node
# actualizado y DB_ALLOW_MIGRATION_REFRESH=false: sin la línea, el próximo `up` de
# storage vuelve a la oficial sin avisar, y pierde las dos cosas.
# DTD_STORAGE_IMAGE=sha256:7ec9901d34a3173a6ccbb6ccf1c58f8833e7a9850757b9efc2a1b8438807d586
# Host público de la app (Traefik enruta `Host` y `www.Host`).
DTD_WEB_HOST=dtdcargo.com
# Host público de la API de Supabase (solo las rutas /auth, /rest, /graphql,
# /storage, /functions y /realtime; Studio y postgres-meta nunca salen por acá).
SUPABASE_PUBLIC_HOST=supabase.dtdcargo.com
# Red externa compartida con Traefik (la crea el runbook: docker network create dtd_edge).
DTD_EDGE_NETWORK=dtd_edge
# Entrypoint TLS y resolver de certificados de Traefik (Dokploy: websecure / letsencrypt).
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
# Carpeta de datos persistentes (PGDATA en <dir>/db, Storage en disco en <dir>/storage).
# En el servidor: /srv/dtd-cargo/data. Relativa al compose si no se cambia.
DTD_DATA_DIR=./data

############
# App (web + cron) · compose.yml
############

# Entorno explícito de la app (lib/runtime/app-env.ts): production | staging.
APP_ENV=production
# URL pública del despliegue, sin barra final (equivale a https://${VERCEL_URL}).
APP_URL=https://dtdcargo.com
# Header que fija el proxy de confianza con la IP real del visitante:
# x-real-ip detrás de Traefik; cf-connecting-ip si Cloudflare va delante con proxy.
REQUEST_IP_HEADER=x-real-ip

# Variables NEXT_PUBLIC_*: se INLINEAN en la imagen al construirla (build args de
# .github/workflows/build-image.yml). Acá van con los MISMOS valores para el
# código servidor que las lee en runtime. Cambiarlas exige reconstruir la imagen.
NEXT_PUBLIC_SITE_URL=https://dtdcargo.com
NEXT_PUBLIC_SUPABASE_URL=https://supabase.dtdcargo.com
# Igual a ANON_KEY (bloque Supabase).
NEXT_PUBLIC_SUPABASE_ANON_KEY=<igual-a-ANON_KEY>
NEXT_PUBLIC_HAILUWAY_API=
NEXT_PUBLIC_BUILD_SHA=
# Nombre de la cookie de sesión que usa HOY Supabase Cloud (sb-<ref>-auth-token).
# Con el host propio el nombre por defecto cambiaría y TODOS tendrían que volver
# a entrar; fijarlo, junto con el mismo JWT_SECRET de Cloud, conserva las
# sesiones abiertas (lib/db/session-cookie.ts). Va también como build arg.
NEXT_PUBLIC_SUPABASE_AUTH_COOKIE=sb-xpfuzqombmjmxvprjgmi-auth-token
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_BUG_REPLAY_ENABLED=

# Igual a SERVICE_ROLE_KEY (bloque Supabase). Nunca llega al navegador.
SUPABASE_SERVICE_ROLE_KEY=<igual-a-SERVICE_ROLE_KEY>
# Bearer que exigen las 20 rutas de app/api/cron/*; lo manda el contenedor cron.
CRON_SECRET=<generar: openssl rand -hex 32>
# Bearer de /api/debug/health (sin él la ruta responde 503 a propósito).
DEBUG_HEALTH_SECRET=<generar: openssl rand -hex 32>
# Modo mantenimiento (lib/runtime/maintenance.ts, SDD-0505). "1" corta TODA
# escritura (API, server actions, rutas que escriben) y muestra «Volvemos en unos
# minutos» en Studio, Back, Portal, /m, /p y /marca; las páginas públicas se
# siguen leyendo. Se usa en la copia final del corte. En Vercel cambiarla exige
# redeploy; en el VPS, recrear `web`.
MAINTENANCE_MODE=
# Clave para revisar la app con el modo puesto (smoke del corte): abrir
# /mantenimiento/entrar?clave=<esta clave> deja una cookie de 4 horas. Vacía: sin
# puerta.
MAINTENANCE_BYPASS_SECRET=<generar: openssl rand -hex 24>
# Aviso de mantenimiento programado en el Portal y /entrar (ISO 8601 con zona;
# hora de Venezuela en pantalla; se oculta solo al pasar el fin). Vacías: sin aviso.
MAINTENANCE_NOTICE_START=
MAINTENANCE_NOTICE_END=

# ── Integraciones de la app ──────────────────────────────────────────────────
# Mismos nombres y significado que el .env.example de la raíz del repo (ahí está
# la explicación de cada una). Las que no se usen quedan vacías: la app degrada
# con gracia o apaga la función. scripts/__tests__/infra-env-example.test.ts
# falla si la raíz suma una variable y esta lista no la tiene.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_WEBHOOK_SECRET=
# VACÍAS A PROPÓSITO, igual que en Vercel (medido el 2026-10-13: ninguna existe
# allí). Sin ellas la app usa SUPABASE_SERVICE_ROLE_KEY como secreto de respaldo
# (lib/studio/mail/unsubscribe-token.ts, lib/marca/access.ts, el hash de IP del
# newsletter): con un valor nuevo aquí, los enlaces de baja ya enviados y las
# cookies de /marca dejarían de valer. Con la service_role de Cloud en este .env,
# el comportamiento es idéntico. DOCUMENT_IMPORT_RATE_SECRET y PAYLOAD_SECRET
# tampoco existen en Vercel: quedan vacías por paridad.
EMAIL_UNSUBSCRIBE_SECRET=
NEWSLETTER_IP_HASH_SECRET=
MARCA_ACCESS_SECRET=
PAYLOAD_SECRET=
DOCUMENT_IMPORT_RATE_SECRET=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
BITACORA_ACTA_MODEL=
BITACORA_ESCUCHA_MODEL=
CONVERSATION_DIGEST_MODEL=
DOCUMENT_IMPORT_MODEL=
DOCUMENT_IMPORT_ENABLED=
DOCUMENT_IMPORT_PORTAL_ENABLED=
DOCUMENT_IMPORT_ALLOWED_ORIGINS=
DOCUMENT_IMPORT_CORPUS=
CF_WHISPER_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SEARATES_API_BASE=
SEARATES_API_KEY=
CHATWOOT_URL=
CHATWOOT_PLATFORM_TOKEN=
