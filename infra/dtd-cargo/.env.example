#   DTD_ATTACHMENTS_PIPL_TRANSFER_VERIFIED_AT, DTD_ATTACHMENTS_RESTORE_DRILL_VERIFIED_AT

############
# Supabase · secretos (compose.supabase.yml)
############

# Contraseña de todos los roles de plataforma (postgres, supabase_admin,
# authenticator, supabase_auth_admin, supabase_storage_admin). Solo letras y
# números: va dentro de URLs de conexión.
POSTGRES_PASSWORD=<generar: openssl rand -hex 32>
# Secreto HS256 (≥ 32 caracteres) con el que GoTrue firma los JWT y con el que
# PostgREST/Realtime/Storage los verifican.
JWT_SECRET=<generar: openssl rand -hex 32>
# Claves API legacy: JWT HS256 firmados con JWT_SECRET, claims role=anon y
# role=service_role, iss=supabase, exp a 10 años. README § "Claves JWT" trae el
# comando. ANON_KEY viaja al navegador; SERVICE_ROLE_KEY salta la RLS: nunca al cliente.
ANON_KEY=<JWT HS256 firmado con JWT_SECRET, role=anon>
SERVICE_ROLE_KEY=<JWT HS256 firmado con JWT_SECRET, role=service_role>
# Claves asimétricas/opacas nuevas (sb_publishable_*/sb_secret_*): vacías = modo
# legacy, que es lo que usa la app hoy.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# JWT_KEYS/JWT_JWKS los escribe infra/ops/migrate/jwks-set.sh: el secreto HS256
# firma (único firmante) y la clave pública ECC de Cloud solo verifica, para que
# las sesiones abiertas antes del corte sigan valiendo. Vacías = solo JWT_SECRET.
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# Basic auth de Studio/postgres-meta en el gateway. Obligatorios y aleatorios
# aunque Studio solo arranque con --profile studio por Tailscale.
DASHBOARD_USERNAME=<generar: openssl rand -hex 8>
DASHBOARD_PASSWORD=<generar: openssl rand -hex 24>

# Realtime y Supavisor (≥ 64 caracteres).
SECRET_KEY_BASE=<generar: openssl rand -base64 48>
# Realtime (exactamente 16 caracteres).
REALTIME_DB_ENC_KEY=<generar: openssl rand -hex 8>
# Supavisor (exactamente 32 caracteres).
VAULT_ENC_KEY=<generar: openssl rand -hex 16>
# Studio ↔ postgres-meta (≥ 32 caracteres).
PG_META_CRYPTO_KEY=<generar: openssl rand -base64 24>
# Endpoint S3 de Storage (protocolo S3 hacia nuestro Storage, no el bucket externo).
S3_PROTOCOL_ACCESS_KEY_ID=<generar: openssl rand -hex 16>
S3_PROTOCOL_ACCESS_KEY_SECRET=<generar: openssl rand -hex 32>

############
# Supabase · URLs y base (compose.supabase.yml)
############

# Mismo origen que NEXT_PUBLIC_SUPABASE_URL: next.config.ts deriva de ahí la CSP
# (img/media/connect) y los remotePatterns de next/image.
SUPABASE_PUBLIC_URL=https://supabase.dtdcargo.com
# URL externa de Auth (enlaces de correo, issuer de los JWT).
API_EXTERNAL_URL=https://supabase.dtdcargo.com/auth/v1

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# Supabase · Auth (GOTRUE_*) · compose.supabase.yml
############

# Site URL y redirecciones permitidas (equivalente al dashboard Auth → URL
# Configuration). /portal/callback es el plan B PKCE de app/entrar/actions.ts.
SITE_URL=https://dtdcargo.com
ADDITIONAL_REDIRECT_URLS=https://dtdcargo.com/portal/callback
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
# TTL del enlace mágico en segundos (1 h; el default de GoTrue es 24 h).
MAILER_OTP_EXP=3600
# Un correo por minuto por destinatario.
GOTRUE_SMTP_MAX_FREQUENCY=60s
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
# Plantillas servidas por el contenedor auth-templates (supabase/templates/).
# magic-link.html es la que setup-portal-auth.md dice que no se borra (plan B).
MAILER_TEMPLATES_MAGIC_LINK=http://auth-templates/magic-link.html
MAILER_TEMPLATES_CONFIRMATION=http://auth-templates/confirmation.html
MAILER_TEMPLATES_INVITE=http://auth-templates/invite.html
MAILER_TEMPLATES_RECOVERY=http://auth-templates/recovery.html
MAILER_TEMPLATES_EMAIL_CHANGE=http://auth-templates/email-change.html
MAILER_TEMPLATES_REAUTHENTICATION=http://auth-templates/reauthentication.html

# SMTP de Auth (Resend por SMTP: smtp.resend.com:587, usuario `resend`, la API
# key como contraseña). Vacíos hasta que Sam cargue las credenciales.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=DTD Cargo

############
# Supabase · Storage (compose.supabase.yml · compose.supabase.s3.yml)
############

# Backend `file` (overlay base): nombre de carpeta bajo DTD_DATA_DIR/storage.
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
# Backend S3 externo (compose.supabase.s3.yml): bucket de R2 o B2 dedicado a
# Storage (distinto del de adjuntos S3_BUCKET). Placeholders, no valores.
STORAGE_S3_BUCKET=<bucket-dedicado-a-storage>
STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=<clave-de-acceso-del-bucket>
STORAGE_S3_SECRET_ACCESS_KEY=<secreto-de-la-clave>
IMGPROXY_AUTO_WEBP=true

############
# Supabase · Edge Functions (compose.supabase.yml)
############

# Aplica a TODAS las funciones. Las cuatro de Kommo corren con verify_jwt=OFF en
# Cloud y se autentican solas (Bearer kommo_cron_key / secreto del webhook):
# con true el router las rechaza antes de ejecutarlas.
FUNCTIONS_VERIFY_JWT=false
# Secretos de las funciones (en Cloud: `supabase secrets set`).
KOMMO_WEBHOOK_SECRET=
KOMMO_PUSH_DRY_RUN=

############
# Supabase · PostgREST, Studio, pooler (compose.supabase.yml)
############

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
# Cloud resuelve también las funciones del esquema `extensions` (uuid-ossp,
# pgcrypto) sin calificar; con solo `public` una RPC que las nombre sin esquema
# fallaría en el VPS (revisión del corte, 2026-10-13).
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
STUDIO_DEFAULT_ORGANIZATION=DTD Cargo
STUDIO_DEFAULT_PROJECT=dtd-cargo
OPENAI_API_KEY=
# Supavisor (solo con --profile pooler).
POOLER_TENANT_ID=dtd-cargo
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

############
# Respaldo diario (backup.sh + systemd/dtd-cargo-backup.timer, 06:00 UTC)
############

# Todo tiene el valor de DTD por defecto dentro de backup.sh; estas líneas solo
# hacen falta para cambiarlo. El remoto es <remoto de rclone>:<bucket>/<prefijo>,
# nunca la raíz del bucket (la retención borra dentro del prefijo).
BACKUP_RCLONE_REMOTE=b2:dtdcargo-respaldos/db
# URL del monitor tipo Push de Uptime Kuma. Solo se llama si el respaldo salió
# bien: si en 26 h no llega, el monitor avisa. Vacío = sin latido.
BACKUP_HEARTBEAT_URL=
# Dónde viven los scripts de ops, los dumps locales, el rclone.conf y las claves
# PÚBLICAS de age (la privada nunca va al servidor).
OPS_DIR=/srv/ops
BACKUP_DIR=/srv/backups
RCLONE_CONFIG_DIR=/srv/ops/backup/rclone
BACKUP_AGE_RECIPIENTS_FILE=/srv/ops/backup/age-recipients.txt
# Retención: 30 días en el bucket y 7 en el disco (decisión de Sam, 2026-10-09).
BACKUP_RETENTION_DAYS=30
BACKUP_LOCAL_RETENTION_DAYS=7
# Volumen con la clave raíz de pgsodium/Vault que config-backup.sh respalda.
BACKUP_DB_CONFIG_VOLUME=dtd-cargo_db-config
