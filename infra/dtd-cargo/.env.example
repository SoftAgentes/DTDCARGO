CHATWOOT_TEAM_LEADS_ID=
CHATWOOT_ROUTER_TOKEN=
WHATSAPP_NUMERO_CLIENTES=
SEARATES_PLATFORM_ID=
SEARATES_TRACKING_API=
SEARATES_TRACKING_MONTHLY_CAP=
SEARATES_TRACKING_RESERVE=
IDENTITY_CNE_PROVIDER=
IDENTITY_CNE_URL=
CBM_ESTUDIO_TOKEN=
DTD_API_KEY=
DTD_ANDROID_CERT_SHA256=
AUDIT_GOVERNED_VIEWER=
PORTAL_COLD_REMINDER=
PORTAL_REVOKED_RETENTION_ENABLED=
PURGE_RECEIPT_ORPHANS_ENABLED=
BITACORA_PURGE_ORPHANS_ENABLED=
# Adjuntos (R2 + antivirus + copia): ver docs/runbooks de attachments.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
DTD_ATTACHMENTS_GASTOS_PILOT=
