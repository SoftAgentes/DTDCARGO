# ─────────────────────────────────────────────────────────────────────────────
# Chatwoot CE en el VPS del ERP (SDD-0583) · plantilla del .env del compose
#
#   cp .env.example .env && chmod 600 .env        (en el servidor: /srv/chatwoot/.env)
#
# SOLO NOMBRES Y PLACEHOLDERS. Ningún valor real vive en el repo y el .env nunca
# entra a git (.gitignore de esta carpeta). Cada `<generar: …>` se reemplaza en el
# servidor; los comandos para generarlos están en docs/runbooks/chatwoot-servidor.md §2.
#
# Este .env solo lo lee Compose para interpolar `${…}`: el contenedor recibe
# únicamente las variables que compose.yml declara en `x-entorno`. Por eso una
# línea vacía aquí no llega como "" a Chatwoot salvo en SMTP_USERNAME y
# SMTP_PASSWORD, que la aceptan.
#
# El .env ES parte del respaldo conjunto (paso 1.5): SECRET_KEY_BASE y las tres
# claves de cifrado no se pueden regenerar sin perder sesiones, tokens de canales
# y secretos de webhooks. Copia en el gestor de contraseñas de Sam al crearlo.
# ─────────────────────────────────────────────────────────────────────────────

############
# Traefik y red
############

# Host público del panel. El registro DNS va en Cloudflare (C-1 del registro E0).
CHATWOOT_HOST=chat.dtdcargo.com
# Red externa compartida solo con Traefik (docker network create chatwoot_edge).
CHATWOOT_EDGE_NETWORK=chatwoot_edge
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
# Orígenes que pueden poner el panel en un iframe (CSP frame-ancestors), separados
# por espacio. Solo el de Studio; el entorno de prueba se agrega cuando E2 lo use.
CHATWOOT_FRAME_ANCESTORS=https://dtdcargo.com
# Carpeta de datos persistentes: <dir>/postgres, <dir>/redis y <dir>/storage (adjuntos).
CHATWOOT_DATA_DIR=/srv/chatwoot/data

############
# Cloudflare Access para /super_admin (P3 con Cloudflare; runbook chatwoot-servidor.md §4)
############

# Apagado mientras estén vacías. Para activarlo, las tres de abajo con los valores de la app
# de Access, más estas dos (sin el # inicial):
#   CHATWOOT_ADMIN_ALLOWLIST_MIDDLEWARE=chatwoot-cf-access@docker
#   COMPOSE_PROFILES=cf-access
# Team domain (también es el `iss` del JWT), p. ej. https://<equipo>.cloudflareaccess.com
CHATWOOT_CF_ACCESS_TEAM_DOMAIN=
# «Application Audience (AUD) Tag» de la app self-hosted de chat.dtdcargo.com/super_admin.
CHATWOOT_CF_ACCESS_AUD=
# Correos admitidos además de la política de Access (segunda red), separados por coma.
CHATWOOT_CF_ACCESS_EMAILS=

############
# Rails
############

CHATWOOT_FRONTEND_URL=https://chat.dtdcargo.com
CHATWOOT_DEFAULT_LOCALE=es
# openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=<generar: openssl rand -hex 64>
# Tope de sesiones simultáneas por usuario (Chatwoot trae 25).
CHATWOOT_MAX_USER_SESSIONS=5

# Revocación de sesiones desde Studio (rails/zz_dtd_revocar_sesiones.rb · SDD-0585, 2.7):
# id del usuario de servicio, el mismo de CHATWOOT_SERVICE_USER_ID en Studio
# (secretos/platform-app.env). Vacío = la ruta responde 503 y no revoca a nadie.
DTD_CHATWOOT_SERVICIO_ID=

CHATWOOT_LOG_LEVEL=info
CHATWOOT_SIDEKIQ_CONCURRENCY=5

############
# Cifrado de columnas (Active Record Encryption)
############

# Las tres salen de `docker compose run --rm --no-deps --entrypoint "" rails bundle exec rails db:encryption:init`
# (imprime las tres; se copian aquí y no se guardan en ningún otro archivo del VPS).
CHATWOOT_AR_ENCRYPTION_PRIMARY_KEY=<generar: rails db:encryption:init>
CHATWOOT_AR_ENCRYPTION_DETERMINISTIC_KEY=<generar: rails db:encryption:init>
CHATWOOT_AR_ENCRYPTION_KEY_DERIVATION_SALT=<generar: rails db:encryption:init>

############
# Postgres y Redis (solo red interna)
############

CHATWOOT_POSTGRES_PASSWORD=<generar: openssl rand -hex 32>
CHATWOOT_REDIS_PASSWORD=<generar: openssl rand -hex 32>

############
# Correo saliente (avisos a agentes y restablecer contraseña)
############

# Remitente y usuario SMTP: el buzón propio notificaciones@dtdcargo.com (Hostinger,
# creado el 2026-10-29; info@ es un alias y no puede iniciar sesión). Puerto 587 con
# STARTTLS. Usuario y clave se pegan con pegar-smtp.sh (runbook §2 bis).
CHATWOOT_MAILER_SENDER_EMAIL="DTD Cargo <notificaciones@dtdcargo.com>"
CHATWOOT_SMTP_ADDRESS=smtp.hostinger.com
CHATWOOT_SMTP_PORT=587
CHATWOOT_SMTP_DOMAIN=dtdcargo.com
CHATWOOT_SMTP_USERNAME=
CHATWOOT_SMTP_PASSWORD=
CHATWOOT_SMTP_AUTHENTICATION=login
CHATWOOT_SMTP_ENABLE_STARTTLS_AUTO=true
CHATWOOT_SMTP_OPENSSL_VERIFY_MODE=peer

############
# Respaldo conjunto (infra/chatwoot/respaldo.sh · runbook chatwoot-respaldo-restauracion.md)
############

# Remoto rclone, fuera de Contabo. Prefijo propio: la retención de los dumps de DTD no lo toca.
CHATWOOT_BACKUP_RCLONE_REMOTE=b2:dtdcargo-respaldos/chatwoot
# Claves PÚBLICAS age (la de Sam y la de emergencia); la privada nunca viene al VPS.
CHATWOOT_BACKUP_AGE_RECIPIENTS=/srv/ops/backup/age-recipients.txt
# URL Push de Uptime Kuma («Respaldo Chatwoot · latido»). Vacía = sin latido.
CHATWOOT_BACKUP_HEARTBEAT_URL=
# URL Push de Uptime Kuma («Chatwoot · recursos del host», vigilar.sh). Vacía = sin latido.
CHATWOOT_VIGILANCIA_HEARTBEAT_URL=
