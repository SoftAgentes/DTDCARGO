<%#
  SDD-0583 · restablecer contraseña. Los parámetros del enlace son los mismos de
  Chatwoot v4.19.1-ce (devise/mailer/reset_password_instructions.html.erb).
  El enlace vence a las 6 horas (config.reset_password_within de la imagen).
%>
<%
  parametros = { reset_password_token: @token }
  parametros[:route_url] = params[:redirect_url] if params[:redirect_url].present?
  parametros[:sso_account_id] = params[:sso_account_id] if params[:sso_account_id].present?
%>
<%= render partial: 'devise/mailer/dtd_aviso', locals: {
  etiqueta: 'Contraseña',
  titulo: 'Elige una contraseña nueva',
  saludo: "Hola, #{@resource.name.presence || @resource.email}:",
  parrafos: [
    'Recibimos un pedido para cambiar la contraseña de tu cuenta del chat de DTD Cargo.',
    'Usa el botón para elegir una nueva. El enlace sirve una sola vez y vence en 6 horas.'
  ],
  detalles: [['Cuenta', @resource.email]],
  boton: 'Elegir contraseña nueva',
  url: frontend_url('auth/password/edit', **parametros),
  nota_titulo: '¿No lo pediste tú?',
  nota: 'Ignora este correo: tu contraseña no cambia hasta que entres al enlace y elijas una nueva.'
} %>
