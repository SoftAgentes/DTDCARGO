<%#
  SDD-0583 · bloque común de los correos de cuenta (contraseña, invitación, desbloqueo).
  Va dentro de la tabla del layout de DTD: por eso son filas <tr>. Locales:
  etiqueta, titulo, saludo, parrafos (lista), detalles (pares), boton, url, nota_titulo, nota.
%>
<tr>
  <td style="padding: 0 0 10px;">
    <p style="margin: 0; font-size: 12px; line-height: 16px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #7F0F1A;"><%= etiqueta %></p>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 16px;">
    <h1 class="dtd-titulo" style="margin: 0; font-family: 'Archivo Black', Archivo, system-ui, sans-serif; font-size: 26px; line-height: 32px; font-weight: 900; color: #0F1E3D;"><%= titulo %></h1>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 10px;">
    <p style="margin: 0; font-size: 15px; line-height: 23px; color: #0F1E3D;"><%= saludo %></p>
  </td>
</tr>
<% parrafos.each do |parrafo| %>
  <tr>
    <td style="padding: 0 0 10px;">
      <p style="margin: 0; font-size: 15px; line-height: 23px; color: #333333;"><%= parrafo %></p>
    </td>
  </tr>
<% end %>
<% if detalles.any? %>
  <tr>
    <td style="padding: 6px 0 16px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width: 100%; border: 1px solid #E8E6E2; border-radius: 8px; background-color: #FBFAF7;" bgcolor="#FBFAF7">
        <% detalles.each_with_index do |(nombre, valor), indice| %>
          <tr>
            <td style="padding: 12px 16px;<%= ' border-top: 1px solid #E8E6E2;' unless indice.zero? %>">
              <p style="margin: 0 0 2px; font-size: 12px; line-height: 16px; color: #6B6B6B;"><%= nombre %></p>
              <p style="margin: 0; font-size: 15px; line-height: 21px; font-weight: 600; color: #0F1E3D;"><%= valor %></p>
            </td>
          </tr>
        <% end %>
      </table>
    </td>
  </tr>
<% end %>
<% if url.present? %>
  <tr>
    <td style="padding: 8px 0 16px;">
      <table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0;">
        <tr>
          <td bgcolor="#7F0F1A" style="border-radius: 8px; background-color: #7F0F1A;">
            <%= link_to(boton, url, style: 'display:inline-block; padding:13px 28px; font-size:15px; line-height:20px; font-weight:700; color:#FFFFFF; text-decoration:none; border-radius:8px;') %>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding: 0 0 16px;">
      <p style="margin: 0; font-size: 13px; line-height: 20px; color: #6B6B6B;">
        Si el botón no abre, usa <%= link_to('este enlace seguro', url, style: 'color:#7F0F1A; text-decoration:underline;') %>.
      </p>
    </td>
  </tr>
<% end %>
<% if nota.present? %>
  <tr>
    <td style="padding: 0 0 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width: 100%; border-left: 3px solid #7F0F1A; background-color: #FBFAF7;" bgcolor="#FBFAF7">
        <tr>
          <td style="padding: 12px 16px;">
            <% if nota_titulo.present? %>
              <p style="margin: 0 0 4px; font-size: 14px; line-height: 20px; font-weight: 700; color: #0F1E3D;"><%= nota_titulo %></p>
            <% end %>
            <p style="margin: 0; font-size: 13px; line-height: 20px; color: #333333;"><%= nota %></p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
<% end %>
