# DTD·CARGO web — variables de entorno
# Copiá este archivo a .env.local y completá los valores reales.

# ─────────────────────────────────────────────────────────────
# ERP HailuWay (HTTP only — sin imports cruzados)
# ─────────────────────────────────────────────────────────────

# URL base del ERP HailuWay (sin barra final).
# Sitio consume endpoints públicos del ERP solo por HTTP.
NEXT_PUBLIC_HAILUWAY_API=http://localhost:3000

# API key que el ERP genera para DTD·CARGO como tenant cliente.
# Se envía en el header X-DTD-Key en todas las requests.
DTD_API_KEY=

# ─────────────────────────────────────────────────────────────
# Sitio público — fallback / referencia
# (la fuente de verdad es Payload site-settings cuando está vivo)
# ─────────────────────────────────────────────────────────────

# Número de WhatsApp Business público (formato internacional sin +, ej. 584121668021).
NEXT_PUBLIC_WHATSAPP_NUMBER=584121668021

# Email de contacto comercial (mostrado en footer).
NEXT_PUBLIC_CONTACT_EMAIL=Vzla@dtdcargo.com

# Dominio canónico (usado para canonical URLs y OG tags).
NEXT_PUBLIC_SITE_URL=https://dtdcargo.com

# ─────────────────────────────────────────────────────────────
# Presentaciones internas protegidas
# ─────────────────────────────────────────────────────────────

# Token para acceder a /admin/cbm-estudio (presentación interna del proyecto
# "Transporte CBM China-Venezuela"). Generar string aleatorio largo (32+ chars):
#   openssl rand -hex 32
# Compartir SOLO con el equipo via canal seguro (no email público).
# Ejemplo de URL: https://dtdcargo.com/admin/cbm-estudio?token=ABC123...
# Si la variable NO está seteada en producción, la ruta retorna 503 (sin acceso).
CBM_ESTUDIO_TOKEN=

# ─────────────────────────────────────────────────────────────
# Payload CMS — base de datos Postgres (Supabase recomendado)
# ─────────────────────────────────────────────────────────────

# Connection string del pooler de Supabase (puerto 6543, no 5432).
# Formato: postgres://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Secret de Payload — 32+ caracteres aleatorios.
# Generar con: openssl rand -hex 32
PAYLOAD_SECRET=

# ─────────────────────────────────────────────────────────────
# Payload CMS — almacenamiento (Supabase Storage, S3-compatible)
# ─────────────────────────────────────────────────────────────

# Endpoint S3 del proyecto Supabase. Formato: https://[REF].supabase.co/storage/v1/s3
S3_ENDPOINT=

# Región del proyecto Supabase (ej. eu-west-2)
S3_REGION=eu-west-2

# Nombre del bucket (crear en Supabase Storage, ej. "media")
S3_BUCKET=media

# Credenciales S3 de Supabase Storage (Settings → Storage → S3 Access Keys)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────
# DTD Studio ERP — backend propio (Supabase)
# ─────────────────────────────────────────────────────────────

# Conexión a Supabase del Studio (no del ERP HailuWay externo).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — usado SOLO para audit del orchestrator de agentes
# (lib/db/admin.ts → insert en agent_runs/agent_approvals).
# NUNCA exponer al cliente, NUNCA usar desde Server Components/Pages.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Agentes y Skills (SDD-0020)
# ─────────────────────────────────────────────────────────────

# Anthropic API key — usada por el runtime de agentes para ejecutar skills.
# Si no está seteada, el endpoint /api/studio/agents/run cae al MockLLMClient
# determinístico (sin gastar tokens). Útil para desarrollo y CI.
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Forzar el mock incluso si ANTHROPIC_API_KEY está set (útil para desarrollo
# o tests sin gastar tokens). Setear a "1" para forzar.
LLM_FORCE_MOCK=
