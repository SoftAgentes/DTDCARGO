# DTD Cargo web — variables de entorno
# Copiá este archivo a .env.local y completá los valores reales.

# ─────────────────────────────────────────────────────────────
# ERP HailuWay (HTTP only — sin imports cruzados)
# ─────────────────────────────────────────────────────────────

# URL base del ERP HailuWay (sin barra final).
# Sitio consume endpoints públicos del ERP solo por HTTP.
NEXT_PUBLIC_HAILUWAY_API=http://localhost:3000

# API key que el ERP genera para DTD Cargo como tenant cliente.
# Se envía en el header X-DTD-Key en todas las requests.
DTD_API_KEY=

# ─────────────────────────────────────────────────────────────
# Sitio público — fallback / referencia
# (la fuente de verdad es Payload site-settings cuando está vivo)
# ─────────────────────────────────────────────────────────────

# Número de WhatsApp Business público (formato internacional sin +, ej. 584121668021).
NEXT_PUBLIC_WHATSAPP_NUMBER=584121668021

# Email de contacto comercial (mostrado en footer).
NEXT_PUBLIC_CONTACT_EMAIL=Vzla@dtdcargo.com

# Dominio canónico (usado para canonical URLs y OG tags).
NEXT_PUBLIC_SITE_URL=https://dtdcargo.com

# ─────────────────────────────────────────────────────────────
# Google Analytics 4 (gtag.js · components/Analytics.tsx)
# ─────────────────────────────────────────────────────────────

# Measurement ID de la propiedad GA4 (formato G-XXXXXXXXXX). Es PÚBLICO (viaja
# en el HTML del sitio), no es un secreto. Si NO se setea, en producción cae al
# ID horneado por default; en desarrollo Analytics queda apagado (no ensucia los
# reportes con tráfico de localhost). Seteá esta var para usar OTRA propiedad o
# para testear GA en dev. Obtener en: GA → Administrar → Flujos de datos.
NEXT_PUBLIC_GA_ID=

# ─────────────────────────────────────────────────────────────
# Presentaciones internas protegidas
# ─────────────────────────────────────────────────────────────

# Token para acceder a /admin/cbm-estudio (presentación interna del proyecto
# "Transporte CBM China-Venezuela"). Generar string aleatorio largo (32+ chars):
#   openssl rand -hex 32
# Compartir SOLO con el equipo via canal seguro (no email público).
# Ejemplo de URL: https://dtdcargo.com/admin/cbm-estudio?token=ABC123...
# Si la variable NO está seteada en producción, la ruta retorna 503 (sin acceso).
CBM_ESTUDIO_TOKEN=

# Secreto para GET /api/debug/health (estado de integraciones del deploy). Gateado
# 2026-06-10: antes era público y exponía rama/commit/URL de Vercel + topología de
# integraciones. Generar string aleatorio largo (openssl rand -hex 32) y poner el
# MISMO valor en Vercel y en .env.local (el Studio lo manda por header para chequear
# prod desde local). Si NO está seteado en el server, la ruta retorna 503.
DEBUG_HEALTH_SECRET=

# ─────────────────────────────────────────────────────────────
# Payload CMS — base de datos Postgres (Supabase recomendado)
# ─────────────────────────────────────────────────────────────

# Connection string del pooler de Supabase (puerto 6543, no 5432).
# Formato: postgres://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Secret de Payload — 32+ caracteres aleatorios.
# Generar con: openssl rand -hex 32
PAYLOAD_SECRET=

# ─────────────────────────────────────────────────────────────
# Payload CMS — almacenamiento (Supabase Storage, S3-compatible)
# ─────────────────────────────────────────────────────────────

# Endpoint S3 del proyecto Supabase. Formato: https://[REF].supabase.co/storage/v1/s3
S3_ENDPOINT=

# Región del proyecto Supabase (ej. eu-west-2)
S3_REGION=eu-west-2

# Nombre del bucket (crear en Supabase Storage, ej. "media")
S3_BUCKET=media

# Credenciales S3 de Supabase Storage (Settings → Storage → S3 Access Keys)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────
# DTD Studio ERP — backend propio (Supabase)
# ─────────────────────────────────────────────────────────────

# Conexión a Supabase del Studio (no del ERP HailuWay externo).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — usado SOLO para audit del orchestrator de agentes
# (lib/db/admin.ts → insert en agent_runs/agent_approvals).
# NUNCA exponer al cliente, NUNCA usar desde Server Components/Pages.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Agentes y Skills (SDD-0020)
# ─────────────────────────────────────────────────────────────

# Anthropic API key — usada por el runtime de agentes para ejecutar skills.
# Si no está seteada, el endpoint /api/studio/agents/run cae al MockLLMClient
# determinístico (sin gastar tokens). Útil para desarrollo y CI.
# Obtener en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Forzar el mock incluso si ANTHROPIC_API_KEY está set (útil para desarrollo
# o tests sin gastar tokens). Setear a "1" para forzar.
LLM_FORCE_MOCK=

# ─────────────────────────────────────────────────────────────
# Bitácora — actas con IA + transcripción de audio (SDD-0146)
# ─────────────────────────────────────────────────────────────

# Modelo del acta (extract.ts). Opcional: si NO se setea, usa el default
# `claude-sonnet-4-6` (el ID cableado en noticias-web/actions.ts). Sin
# ANTHROPIC_API_KEY (o con LLM_FORCE_MOCK=1) la extracción cae al mock
# determinista — dev/CI no gastan tokens. Subir el ID acá cuando el norte
# `claude-sonnet-5` esté disponible, sin tocar código.
BITACORA_ACTA_MODEL=

# Transcripción de audio → Cloudflare Workers AI (Whisper large-v3-turbo).
# Se probó CF porque Groq geo-bloquea Venezuela. SERVER-ONLY (sin NEXT_PUBLIC_:
# el token no debe viajar al bundle del cliente). Fail-closed: si FALTA cualquiera
# de las dos, la route /api/studio/bitacora/transcribe responde 503 "transcripción
# no configurada" y el flujo de pegar texto sigue vivo (NO hay mock de audio).
# Obtener: dashboard Cloudflare → Workers AI (Account ID) + My Profile → API Tokens
# (token con permiso "Workers AI: Read"). Cargar ambos en Vercel antes de usar audio.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Modelo de Whisper en CF. Opcional: default `@cf/openai/whisper-large-v3-turbo`.
CF_WHISPER_MODEL=

# GC de audios huérfanos del bucket `bitacora` (cron bitacora-purge-orphans,
# SDD-0146 Fase 6). Fail-closed: dry-run por defecto (solo reporta conteos en
# logs). Poner "true" para que borre de verdad (el founder revisa antes de
# activar). Solo toca `{tenant}/bitacora_meeting/` >7 días sin fila que lo
# apunte; NUNCA los adjuntos de tarea.
BITACORA_PURGE_ORPHANS_ENABLED=

# ─────────────────────────────────────────────────────────────
# OpenRouter — proveedor LLM alternativo (multi-modelo)
# ─────────────────────────────────────────────────────────────

# API key de OpenRouter.ai (formato sk-or-v1-xxxxxxxxxxxxxxxx).
# Obtener en: https://openrouter.ai/keys
# Usado como proveedor LLM alternativo cuando se quiere routear a modelos
# no-Anthropic (GPT, Gemini, Llama, Mistral, etc.) via single API.
# Si NO está set, el Studio no expone el provider OpenRouter (queda solo
# Anthropic + Mock disponibles en el factory).
OPENROUTER_API_KEY=

# ─────────────────────────────────────────────────────────────
# Mailing — Resend (SDD-0026 Fase 2)
# ─────────────────────────────────────────────────────────────

# API key de Resend (formato re_xxxxxxxxxxxxxxxxxxxx).
# Obtener en: https://resend.com/api-keys (Sending access · domain dtdcargo.com).
# Si NO está set, sendEmail() opera en mock mode: el mail_log queda en
# status='queued' y no se hace request HTTP (útil para dev/CI sin gastar cuota).
# Setup completo: docs/runbooks/setup-resend.md
RESEND_API_KEY=

# Signing secret del webhook de Resend (formato whsec_xxxxxxxxxxxxxxxxxx).
# Obtener al crear el endpoint en: https://resend.com/webhooks
# Endpoint URL prod: https://dtdcargo.com/api/webhooks/resend
# Si NO está set, /api/webhooks/resend devuelve 503 y no procesa nada.
RESEND_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# SeaRates Logistics Explorer — fletes marítimos (benchmark interno)
# ─────────────────────────────────────────────────────────────
# SDD-0092 Fase 1. El rate de SeaRates es REFERENCIA para el costing/pricing de
# DTD (benchmark interno · admin), NO el precio final al cliente. Server-only:
# NINGUNA de estas vars lleva prefijo NEXT_PUBLIC_ (el secreto no debe viajar al
# bundle del cliente). Si SEARATES_API_KEY NO está set, getOceanRate() opera en
# mock mode: devuelve { ok:false, error:'mock_no_key' } sin hacer request HTTP.
# Cuota: 100 llamadas/mes (vence 2026-07-17) → no quemar en dev/CI.

# Endpoint GraphQL de RATES (la API REAL es GraphQL, confirmado en
# docs.searates.com/reference/logistics). getOceanRate() hace POST a esta URL con
# { query, variables } y header Authorization: Bearer <token>. Variables:
# pointIdFrom/pointIdTo ("P_<n>"), shippingType (FCL|LCL), container (FCL), date.
# El AUTH es aparte y vive fijo en https://www.searates.com
# (GET /auth/platform-token?id=...&api_key=...). Sin barra final.
SEARATES_API_BASE=https://rates.searates.com/graphql

# Platform ID de la cuenta DTD en SeaRates. NO es secreto (va en la query de auth).
SEARATES_PLATFORM_ID=46314

# API Key SECRETA de SeaRates. SERVER ONLY · va en .env.local (local) + Vercel env.
# NUNCA commitear el valor real ni anteponerle NEXT_PUBLIC_.
SEARATES_API_KEY=

# ─────────────────────────────────────────────────────────────
# Web Push — notificaciones operario (Sprint 4 v3)
# ─────────────────────────────────────────────────────────────

# Par de llaves VAPID. Generar UNA vez con:
#   pnpm exec web-push generate-vapid-keys
# Si NO están set, el push opera en no-op (la PWA no muestra el opt-in y
# sendPushToOperario hace warning + return 0). Setup: docs/runbooks/setup-web-push.md

# Public key (va al bundle del cliente · es pública, sin problema).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Private key (SERVER ONLY · nunca con prefijo NEXT_PUBLIC_).
VAPID_PRIVATE_KEY=

# Contacto del servidor VAPID (mailto: que el push service puede usar para
# contactar si hay abuso). Default: mailto:vzla@dtdcargo.com
VAPID_SUBJECT=mailto:vzla@dtdcargo.com

# Secret compartido para autorizar los crons (/api/cron/*). Generar con:
#   openssl rand -hex 32
# Ya usado por ceo-brief; el push-drain lo reusa.
CRON_SECRET=

# Adopción: recordatorio automático a fríos del portal (/api/cron/portal-cold-reminder).
# OFF por default. Poner "on" para que el cron reenvíe el enlace a los invitados que
# nunca lo abrieron (espera 3 días, cooldown 5 días, tope 2 correos por cliente).
PORTAL_COLD_REMINDER=

# ─────────────────────────────────────────────────────────────
# Android APK — TWA (PWA operario empaquetada, sin Play Store)
# ─────────────────────────────────────────────────────────────

# Fingerprint(s) SHA-256 del keystore de FIRMA del APK TWA. Habilita el
# Digital Asset Links en /.well-known/assetlinks.json para que la PWA abra
# sin barra de URL. Coma-separado si hay varias llaves (debug + release o
# rotación). Obtener con bubblewrap (lo imprime al buildear) o:
#   keytool -list -v -keystore android.keystore -alias android | grep SHA256
# Formato: AA:BB:CC:...:FF  (mayúsculas, separado por ':')
# Si NO está set, el endpoint usa el fingerprint horneado por default (el del
# APK actual · package com.dtdcargo.twa). Override solo si rotás el keystore.
# Setup completo: docs/runbooks/setup-android-apk.md
DTD_ANDROID_CERT_SHA256=
# SDD-0224 · piloto de adjuntos Gastos (apagado por defecto)
DTD_ATTACHMENTS_GASTOS_PILOT=0
DTD_ATTACHMENTS_PRODUCTION_CONFIRMED=0
DTD_ATTACHMENTS_AV_URL=
DTD_ATTACHMENTS_AV_TOKEN=
DTD_ATTACHMENTS_BACKUP_ENDPOINT=
DTD_ATTACHMENTS_BACKUP_REGION=
DTD_ATTACHMENTS_BACKUP_BUCKET=
DTD_ATTACHMENTS_BACKUP_ACCESS_KEY_ID=
DTD_ATTACHMENTS_BACKUP_SECRET_ACCESS_KEY=
DTD_ATTACHMENTS_DRILL_ALLOW=0
DTD_ATTACHMENTS_DRILL_OBJECT_KEY=
DTD_ATTACHMENTS_DRILL_VERSION_ID=
DTD_ATTACHMENTS_DRILL_SHA256=

# ─────────────────────────────────────────────────────────────
# Variables que el código lee y que faltaban acá (auditadas 2026-08-02)
# ─────────────────────────────────────────────────────────────
# Se documentan porque un `.env.example` incompleto obliga a leer el código
# para levantar el proyecto. NO se listan las que inyecta la plataforma
# (NODE_ENV, VERCEL_*, LOCALAPPDATA) ni los interruptores del harness
# (VERIFY_STRICT, VERIFY_SKIP_SQL, VERIFY_SKIP_E2E, VERIFY_CHILD,
# SQL_TEST_PG_IMAGE, PLAYWRIGHT_BROWSERS_PATH, E2E_*): esos no son config.

# Centro de marca /marca (SDD-0238) · firma del código de acceso de 4-6 dígitos.
# Sin valor cae a un default de desarrollo → en producción SIEMPRE setearlo.
MARCA_ACCESS_SECRET=

# Visor gobernado del audit log en /studio/admin. Sólo se muestra si != "0".
AUDIT_GOVERNED_VIEWER=

# Firma HMAC del link de baja de correos (SDD-0082). Si cambia, los links de
# unsubscribe ya enviados dejan de validar.
EMAIL_UNSUBSCRIBE_SECRET=

# Sal para hashear la IP del suscriptor del newsletter (no se guarda la IP cruda).
NEWSLETTER_IP_HASH_SECRET=

# Verificación del webhook de correo entrante de Resend (SDD-0056, conversaciones).
RESEND_INBOUND_WEBHOOK_SECRET=

# Telegram (bot @DTDStudioBot): token del bot, secreto del webhook y el usuario
# público que el Studio muestra para que el empleado inicie el chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Validación de identidad contra CNE (advisory). La integración se considera
# activa sólo si están las DOS.
IDENTITY_CNE_PROVIDER=
IDENTITY_CNE_URL=

# SeaRates · rastreo de navieras. El cap y la reserva protegen la cuota mensual
# del plan: sin ellos el módulo puede agotarla sin aviso.
SEARATES_TRACKING_API=
SEARATES_TRACKING_MONTHLY_CAP=
SEARATES_TRACKING_RESERVE=

# Modelos de IA por feature (si no se setean, cada uno cae a su default en código).
BITACORA_ESCUCHA_MODEL=
CONVERSATION_DIGEST_MODEL=

# Token de la API de Vercel para leer el estado de los deploys desde el Studio.
VERCEL_API_TOKEN=

# SHA del build, mostrado en el panel de estado del entorno.
NEXT_PUBLIC_BUILD_SHA=

# Limpiador heredado de fotos/POD huérfanas. ⚠️ PROHIBIDO encenderlo en
# Producción por mandato del founder (SDD-0224 §8.1) mientras su modelo sea
# borrar físicamente a los 7 días. Se documenta para que quede explícito que va
# apagado — su gemela BITACORA_PURGE_ORPHANS_ENABLED ya estaba listada.
PURGE_RECEIPT_ORPHANS_ENABLED=
