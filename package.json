{
  "name": "dtdcargo-web",
  "version": "0.1.0",
  "private": true,
  "description": "Sitio web público de DTD Cargo — cliente del ERP HailuWay, totalmente aislado.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/norte.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node scripts/prune-next-types.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed": "tsx scripts/seed.ts",
    "seed:marca": "tsx scripts/seed-brand-catalog.ts",
    "seed:e2e": "tsx scripts/seed-e2e.ts",
    "verify:e2e-teardown": "tsx scripts/verify-e2e-teardown.ts",
    "components:index": "node scripts/build-component-registry.mjs",
    "components:check": "node scripts/validate-component-registry.mjs",
    "governance:index": "node scripts/build-governance-capsule.mjs",
    "governance:check": "node scripts/build-governance-capsule.mjs --check",
    "governance:plugin:test": "node .agents/plugins/plugins/erp-studio-governance/scripts/run-forward-tests.mjs",
    "governance:plugin:sync": "node .agents/plugins/plugins/erp-studio-governance/scripts/reinstall-plugin.mjs --install",
    "governance:plugin:check": "node .agents/plugins/plugins/erp-studio-governance/scripts/reinstall-plugin.mjs --check",
    "docs:index": "node scripts/build-docs-index.mjs",
    "docs:check": "node scripts/build-docs-index.mjs --check",
    "sdd:next": "node scripts/next-number.mjs",
    "sdd:check": "node scripts/check-numbering.mjs",
    "edge:check": "node scripts/check-edge-functions.mjs",
    "attachments:preflight": "node scripts/attachments-pilot-preflight.mjs",
    "attachments:r2:validate": "node scripts/attachments-r2-live-validation.mjs",
    "attachments:clamav:serve": "node scripts/attachments-clamav-http.mjs",
    "attachments:aws:deploy": "node scripts/attachments-aws-deploy.mjs",
    "attachments:aws:validate": "node scripts/attachments-aws-live-validation.mjs",
    "attachments:aws:postflight": "node scripts/attachments-aws-postflight.mjs",
    "build:packlist-template": "node scripts/build-packlist-template.mjs",
    "marketing:reader": "node scripts/build-marketing-reader.mjs",
    "verify": "node scripts/verify.mjs",
    "harness:status": "node scripts/director-status.mjs",
    "harness:test": "node --test scripts/tests/director-status.node.mjs scripts/tests/harness-worktree.node.mjs scripts/tests/next-number.integration.node.mjs scripts/tests/verify-critical-coverage.node.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@aws-sdk/client-cloudformation": "3.1099.0",
    "@aws-sdk/client-s3": "^3.1099.0",
    "@aws-sdk/client-sqs": "^3.1099.0",
    "@aws-sdk/client-sts": "3.1099.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.106.1",
    "@types/qrcode": "^1.5.6",
    "@uppy/core": "^5.2.0",
    "@uppy/tus": "^5.1.1",
    "agentation": "^3.0.2",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "file-type": "^22.0.1",
    "next": "16.2.11",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rrweb": "^2.0.0-alpha.4",
    "rrweb-player": "^1.0.0-alpha.4",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.7",
    "agentation-mcp": "^1.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "exceljs": "^4.4.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}
